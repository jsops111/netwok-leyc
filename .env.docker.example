# ===========================================================================
# Docker 部署配置。复制成 .env.docker 再改:
#     cp .env.docker.example .env.docker
#
# 两个密钥必须自己生成,**不要用示例值上生产**:
#   DJANGO_SECRET_KEY        python -c "import secrets;print(secrets.token_urlsafe(50))"
#   NETCHECK_ENCRYPTION_KEY  见下面 NETCHECK_ENCRYPTION_KEY 那一节的生成命令
# ===========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=CHANGE_ME_请生成一个随机串
DJANGO_DEBUG=false
# 反代/域名部署时填实际域名,如 netcheck.example.com,多个用逗号分隔
DJANGO_ALLOWED_HOSTS=*

# ---- 凭据加密密钥 ----
# 生成:python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# ⚠ **丢了这个密钥,库里所有 SNMP community / SSH 口令 / API token 都解不出来。**
#   它和数据库备份要分开存 —— 一起丢了等于没加密。
NETCHECK_ENCRYPTION_KEY=CHANGE_ME_请生成一个_Fernet_密钥

# ---- PostgreSQL(容器内) ----
POSTGRES_DB=network_check
POSTGRES_USER=netcheck
POSTGRES_PASSWORD=CHANGE_ME_请设一个强密码
POSTGRES_PORT=5432

# ---- Redis(容器内) ----
REDIS_PASSWORD=CHANGE_ME_请设一个强密码
REDIS_PORT=6379
# 容器内是独占的 Redis,所以从 0 开始用就行(和裸机部署共用实例时才要错开)
CELERY_BROKER_DB=0
CELERY_RESULT_DB=1
NETCHECK_CACHE_DB=2

# ---- 拨测参数 ----
# beat 每几秒唤醒派发器。要支持"每秒一次"的线路就填 1;
# 线路都在 10 秒以上的话填 5 能显著降低 beat 和 Redis 的空转
NETCHECK_TICK_SECONDS=1
# 原始秒级样本保留时长(小时)。一条 1 秒频率的线路一天 86400 行,
# 按线路数估算磁盘:48 小时 × 线路数 × 86400 行 ≈ 每条线路 ~20MB/天
NETCHECK_RAW_RETENTION_HOURS=48

# ---- 对外端口 ----
WEB_PORT=18120
